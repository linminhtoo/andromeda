{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "rootDir": "src/finrag/static/ts",
    "outDir": "src/finrag/static/js",
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["src/finrag/static/ts/**/*.ts"]
}
