# Copy to `.env` and fill in values for your environment.
#
# Notes:
# - `.env` is gitignored.
# - For local OpenAI-compatible endpoints (vLLM), set OPENAI_API_KEY=test.

# --- Core backend ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/andromeda
# DATABASE_URL can be used instead of POSTGRES_DSN.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andromeda

# --- LLM provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=

# HTML -> Markdown (Marker OCR + processors)
OPENAI_BASE_URL=http://localhost:8993/v1

# Runtime QA + indexing
# used during build_index.py (via build_index.sh) and main.py
OPENAI_CHAT_BASE_URL=http://localhost:8993/v1
OPENAI_EMBED_BASE_URL=http://localhost:8913/v1
# used only by build_index.py (via build_index.sh)
OPENAI_CONTEXT_BASE_URL=http://localhost:8993/v1

# Optional model overrides
# change these to your desired models
OPENAI_CHAT_MODEL="Qwen/Qwen3-VL-32B-Instruct-FP8"
OPENAI_EMBED_MODEL="BAAI/bge-m3"
# CHAT_MODEL=
# EMBED_MODEL=

# Optional Mistral configuration
# MISTRAL_API_KEY=
# MISTRAL_CHAT_MODEL=
# MISTRAL_EMBED_MODEL=

# Optional LangSmith tracing (provider calls only, not app-level tracing)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Optional endpoint override for Marker section-header correction.
# SECTIONHEADER_OPENAI_BASE_URL=http://localhost:8993/v1

# Optional retrieval-context settings (for build_index.py / runtime display)
CONTEXT_STRATEGY=neighbors
CONTEXT_WINDOW=8
CONTEXT_METADATA_KEY=retrieval_context

# Optional build_index.sh ANN controls
# ANN_HNSW_M=24
# ANN_HNSW_EF_CONSTRUCTION=200
# RECREATE_ANN_INDEX=true
# RESET_CORPUS=true

# Optional path used by /ingested_companies endpoint.
# FINRAG_DOC_INDEX_PATH=./data/sec_filings_md_v5/chunked_1024_128/doc_index.jsonl

# --- vLLM scripts ---
VLLM_API_KEY=test
CUDA_VISIBLE_DEVICES=0,1
