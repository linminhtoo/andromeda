# Copy to `.env` and fill in values for your environment.
#
# Notes:
# - `.env` is gitignored.
# - For local OpenAI-compatible endpoints (vLLM), set OPENAI_API_KEY=test.

# --- Core backend ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/andromeda
# DATABASE_URL can be used instead of POSTGRES_DSN.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andromeda

# --- LLM provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Runtime QA + indexing
# used during build_index.py (via build_index.sh) and main.py
OPENAI_CHAT_BASE_URL=http://localhost:8993/v1
OPENAI_EMBED_BASE_URL=http://localhost:8913/v1
# used only by build_index.py (via build_index.sh)
OPENAI_CONTEXT_BASE_URL=http://localhost:8993/v1

# Optional model overrides
# change these to your desired models
OPENAI_CHAT_MODEL="Qwen/Qwen3-VL-32B-Instruct-FP8"
OPENAI_EMBED_MODEL="BAAI/bge-m3"

# Optional Mistral configuration
# MISTRAL_API_KEY=
# MISTRAL_CHAT_MODEL=
# MISTRAL_EMBED_MODEL=

# Data Ingestion Controls
# POSTGRES_SCHEMA=exp_ctx_neighbors_w1_m24_ef200
POSTGRES_SCHEMA=eval_revamp_combined_512_20260217
# Chunker settings
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNKER_NAME=markdown_table_preserving
# Context settings
# CONTEXT_STRATEGY=neighbors
CONTEXT_STRATEGY=none
CONTEXT_WINDOW=1
CONTEXT_METADATA_KEY=retrieval_context
CONTEXT_MAX_TOKENS=256
# HNSW index settings
ANN_HNSW_M=24
ANN_HNSW_EF_CONSTRUCTION=200
# Sparse retrieval method: bm25 (default, requires pg_textsearch on PG17/18) or fts.
POSTGRES_SPARSE_SEARCH_METHOD=bm25
# DEPRECATED FOR NOW: Narrative retrieval controls.
# Query expansion is disabled by default to avoid user-query drift.
# FINRAG_ENABLE_NARRATIVE_QUERY_EXPANSION=0
# Keep narrative aspect coverage enabled as a low-overhead faithfulness guardrail.
# FINRAG_ENABLE_NARRATIVE_ASPECT_COVERAGE=1
# RECREATE_ANN_INDEX=true
# RESET_CORPUS=true
# ALLOW_DEFAULT_SCHEMA_MUTATIONS=true
DEBUG_SAMPLE_RATE=0.02
DEBUG_MAX_SAMPLES=100
DEBUG_SAMPLE_SEED=42

# /ingested_companies resolves doc index from FINRAG_INGEST_PROFILE by default.
# Keep FINRAG_DOC_INDEX_PATH unset in .env to avoid stale path drift across runs.

# Optional LangSmith tracing (provider calls only, not app-level tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# --- vLLM scripts ---
VLLM_API_KEY=test
CUDA_VISIBLE_DEVICES=0,1
